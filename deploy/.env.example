# WonkVOD release identity. The deploy script supplies the Git revision and
# uses 1.0.1 unless this is explicitly overridden.
WONKVOD_APP_VERSION=1.0.1

# Public Plex endpoint published by the claimed plex-identity sidecar.
# Replace both placeholders with the address and plex.direct hostname issued
# for your own sidecar identity.
WONKVOD_SECURE_URI=https://192-0-2-10.example.plex.direct:32499
PLEX_TLS_HOSTNAME=192-0-2-10.example.plex.direct
WONKVOD_MACHINE_IDENTIFIER=MACHINE_IDENTIFIER
WONKVOD_PLEX_PORT=32499

# Web Setup binds to loopback by default. Use a trusted LAN address only when
# direct LAN access is intentional; do not expose plain HTTP to the Internet.
WONKVOD_WEB_BIND_IP=127.0.0.1
WONKVOD_WEB_PORT=32501

# Persistent and sidecar paths.
WONKVOD_STATE_DIR=/opt/wonkvod-runtime/state
WONKVOD_PROVIDER_ENV_FILE=/opt/wonkvod-runtime/xtream.env
PLEX_IDENTITY_CONFIG_DIR="/opt/plex-identity/config/Library/Application Support/Plex Media Server"
PLEX_IDENTITY_CONTROL_MEDIA="/opt/plex-identity/control-media/movies/WonkVOD Control.mp4"
PLEX_IDENTITY_NETWORK=plex-identity_default
# External Docker network containing the optional provider HTTP proxy.
WONKVOD_PROVIDER_PROXY_NETWORK=gluetun_default
# Optional provider-only HTTP egress proxy. Leave empty for direct networking.
WONKVOD_PROVIDER_PROXY_URL=
# Set these to the numeric owner of Preferences.xml and Cache/cert-v2.p12.
PLEX_IDENTITY_UID=1000
PLEX_IDENTITY_GID=1000

# Optional request profiling. Keep disabled during normal operation.
WONKVOD_PROFILE_REQUESTS=0
